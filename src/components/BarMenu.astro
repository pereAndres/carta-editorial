---
import type { RestaurantMenu } from '../data/menus';
import { dishImage, noPhotoSections, sectionId } from '../lib/menu';
import MenuPhoto from './MenuPhoto.astro';
import AllergenInfo from './AllergenInfo.astro';

interface Props { menu: RestaurantMenu }
const { menu } = Astro.props;
const feature = menu.sections.flatMap((section) => section.items).find((item) => item.name === 'Patatas bravas');
const boardItems = [menu.sections[0].items[0], menu.sections[2].items[1]];
---

<article class="bar-menu" aria-label={`Carta de ${menu.name}`}>
  <header class="bar-heading">
    <span class="bar-heading__overline">Bar de tapas · Desde 1987</span>
    <h2>La Buena<br class="bar-heading__break" /> Sombra<span class="bar-heading__dot">.</span></h2>
    <p>La barra de siempre, para quedarse un rato más.</p>
  </header>

  {feature && <figure class="bar-feature">
    <MenuPhoto src={dishImage(menu.id, feature.name)} name={feature.name} width={900} height={600} loading="eager" priority />
    <figcaption><strong>De la casa</strong><span>Patatas bravas · {feature.price}</span></figcaption>
  </figure>}

  <nav class="bar-jumps" aria-label="Secciones de la carta del bar">
    {menu.sections.map((section, index) => <a href={`#${sectionId(menu.id, index)}`}>{section.title}</a>)}
  </nav>

  <div class="bar-sections">
    {menu.sections.map((section, index) => <Fragment><section class="bar-section" id={sectionId(menu.id, index)} aria-labelledby={`bar-title-${index}`}>
      <div class="bar-section__heading"><h3 id={`bar-title-${index}`}>{section.title}</h3>{section.note && <p>{section.note}</p>}</div>
      <ul class="bar-list">
        {section.items.map((item) => <li class:list={['bar-item', { 'bar-item--drink': noPhotoSections.has(section.title) }]}>
          {!noPhotoSections.has(section.title) && <MenuPhoto src={dishImage(menu.id, item.name)} name={item.name} width={144} height={144} />}
          <div class="bar-item__copy"><h4>{item.name}</h4><p>{item.description}</p>
            {!noPhotoSections.has(section.title) && <AllergenInfo dish={item} theme="bar" />}
          </div>
          <div class="bar-item__prices">
            {item.halfPrice && <span><small>Media</small>{item.halfPrice}</span>}
            {item.price && <span><small>{item.halfPrice ? 'Ración' : ''}</small>{item.price}</span>}
          </div>
        </li>)}
      </ul>
    </section>{index === 0 && <aside class="bar-board" aria-label="Sugerencias de la casa">
      <div class="bar-board__heading"><span>La pizarra</span><strong>Para empezar</strong></div>
      <ul>{boardItems.map((item) => <li><span>{item.name}</span><b>{item.price}</b></li>)}</ul>
      <p>Dos favoritos de la barra para abrir mesa.</p>
    </aside>}</Fragment>)}
  </div>
  <footer class="bar-footer"><span>Pregunta por los alérgenos antes de pedir.</span><a href="#cartas">Cambiar carta ↑</a></footer>
</article>
