---
import type { RestaurantMenu } from '../data/menus';
import { dishImage } from '../lib/menu';
import MenuPhoto from './MenuPhoto.astro';
import AllergenInfo from './AllergenInfo.astro';

interface Props { menu: RestaurantMenu }
const { menu } = Astro.props;
const courses = menu.sections[0].items;
const acts = ['I · La huerta', 'II · El mar', 'III · Brasa y tierra', 'IV · El final'];
const courseTitle = (name: string) => name.replace(/^\d{2}\s*·\s*/, '');
---

<article class="tasting-menu" aria-label={`Menú degustación de ${menu.name}`}>
  <header class="tasting-heading">
    <div class="tasting-heading__brand">UMBRAL</div>
    <p>Menú degustación</p>
    <h2>Ocho momentos</h2>
    <span>Un recorrido por el litoral y la huerta, servido a su ritmo.</span>
  </header>

  {menu.special && <div class="tasting-price" aria-label="Precio y maridajes">
    <div><strong>{menu.special.price.split(' / ')[0]}</strong><span>Por persona · Menú completo · 8 pases</span></div>
    <ul>{menu.special.details.map((detail) => <li>{detail}</li>)}</ul>
    <a class="tasting-price__wine-link" href="#bodega">Explorar la bodega <span aria-hidden="true">↓</span></a>
  </div>}

  <div class="tasting-route" aria-label="Secuencia de ocho pases">
    {courses.map((_, index) => <span>{String(index + 1).padStart(2, '0')}</span>)}
  </div>

  <ol class="tasting-courses">
    {courses.map((course, index) => <li class:list={['tasting-course', { 'tasting-course--act-opener': index % 2 === 0, 'tasting-course--followup': index % 2 === 1 }]} id={`pase-${index + 1}`}>
      {index % 2 === 0 && <div class="tasting-act"><div><span>{acts[index / 2]}</span><span>{String(index + 1).padStart(2, '0')}—{String(index + 2).padStart(2, '0')}</span></div>{menu.wines?.[index / 2] && <a href={`#vino-${index / 2 + 1}`}>En la bodega: {menu.wines[index / 2].name} ↓</a>}</div>}
      <div class="tasting-course__heading"><span>{String(index + 1).padStart(2, '0')}</span><div><small>{index === 0 ? 'El comienzo' : index === 7 ? 'El final' : `Pase ${index + 1}`}</small><h3>{courseTitle(course.name)}</h3><p>{course.description}</p></div></div>
      <MenuPhoto src={dishImage(menu.id, course.name)} name={courseTitle(course.name)} width={900} height={570} loading={index === 0 ? 'eager' : 'lazy'} priority={index === 0} />
      <AllergenInfo dish={course} theme="michelin" />
    </li>)}
  </ol>
  {menu.wines && <section class="tasting-wines" id="bodega" aria-labelledby="tasting-wines-title">
    <header class="tasting-wines__heading">
      <span>Selección del sumiller · Carta de ejemplo</span>
      <h2 id="tasting-wines-title">La bodega</h2>
      <p>Cuatro estilos para seguir el paisaje, también disponibles por copa.</p>
    </header>
    <div class="tasting-wines__columns"><span>La selección</span><span>Copa</span><span>Botella</span></div>
    <ol class="tasting-wines__list">
      {menu.wines.map((wine, index) => <li class="tasting-wine" id={`vino-${index + 1}`}>
        <div class="tasting-wine__top"><span>{String(index + 1).padStart(2, '0')}</span><span>{wine.moment}</span></div>
        <div class="tasting-wine__main"><div><h3>{wine.name}</h3><p class="tasting-wine__origin">{wine.origin} <span aria-hidden="true">·</span> {wine.grapes}</p><p class="tasting-wine__note">{wine.note}</p></div><strong>{wine.glass}</strong><strong>{wine.bottle}</strong></div>
      </li>)}
    </ol>
    <p class="tasting-wines__foot">Selección y precios ilustrativos. Consulta las botellas, añadas y alérgenos disponibles en el restaurante.</p>
  </section>}
  <footer class="tasting-footer"><p>El menú se sirve a mesa completa. Indícanos cualquier restricción alimentaria al reservar.</p><a href="#cartas">Cambiar carta ↑</a></footer>
</article>
