---
import type { RestaurantMenu } from '../data/menus';
import { dishImage, noPhotoSections, sectionId } from '../lib/menu';
import MenuPhoto from './MenuPhoto.astro';
import AllergenInfo from './AllergenInfo.astro';

interface Props { menu: RestaurantMenu }
const { menu } = Astro.props;
const sectionStart = (index: number) => menu.sections.slice(0, index).reduce((sum, section) => sum + section.items.length, 0);
const method = (name: string, sectionIndex: number) => sectionIndex === 0 ? 'Al vapor' : name.includes('wok') || name.includes('brócoli') ? 'Al wok' : name.includes('char siu') ? 'Asado' : undefined;
---

<article class="canton-menu" aria-label={`Carta de ${menu.name}`}>
  <header class="canton-heading">
    <div><span aria-hidden="true">点心</span><h2>Casa Wong</h2></div>
    <p>Dim sum y cocina cantonesa para compartir.</p>
  </header>

  <nav class="canton-jumps" aria-label="Secciones de Casa Wong">
    {menu.sections.map((section, index) => <a href={`#${sectionId(menu.id, index)}`}>{section.title.split(' · ')[0]}</a>)}
  </nav>

  <div class="canton-sections">
    {menu.sections.map((section, sectionIndex) => <section class:list={['canton-section', { 'canton-section--dimsum': sectionIndex === 0 }]} id={sectionId(menu.id, sectionIndex)} aria-labelledby={`canton-title-${sectionIndex}`}>
      <header class="canton-section__heading"><span>{String(sectionIndex + 1).padStart(2, '0')}</span><div><h3 id={`canton-title-${sectionIndex}`}>{section.title}</h3>{section.note && <p>{section.note}</p>}</div></header>
      <ol class="canton-list" start={sectionStart(sectionIndex) + 1}>
        {section.items.map((item, itemIndex) => <li class:list={['canton-item', { 'canton-item--drink': noPhotoSections.has(section.title) }]}>
          {!noPhotoSections.has(section.title) && <MenuPhoto src={dishImage(menu.id, item.name)} name={item.name} width={540} height={390} loading={sectionIndex === 0 && itemIndex === 0 ? 'eager' : 'lazy'} priority={sectionIndex === 0 && itemIndex === 0} />}
          <div class="canton-item__line"><span class="canton-item__number">{String(sectionStart(sectionIndex) + itemIndex + 1).padStart(2, '0')}</span><div class="canton-item__copy"><h4>{item.name}</h4><p>{item.description}</p></div>{item.price && <strong>{item.price}</strong>}</div>
          {(item.pieces || method(item.name, sectionIndex)) && <div class="canton-item__stamps">{item.pieces && <span>{item.pieces} por cesta</span>}{method(item.name, sectionIndex) && <span>{method(item.name, sectionIndex)}</span>}</div>}
          {!noPhotoSections.has(section.title) && <AllergenInfo dish={item} theme="canton" />}
        </li>)}
      </ol>
    </section>)}
  </div>
  <footer class="canton-footer"><p>Pregunta por los alérgenos antes de pedir.</p><a href="#cartas">Cambiar carta ↑</a></footer>
</article>
