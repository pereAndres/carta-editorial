---
import type { Dish } from '../data/menu';
interface Props { dish: Dish; index: number }
const { dish, index } = Astro.props;
const photo = dish.image === 'hero' ? '/images/materia-viva-hero.png' : '/images/materia-viva-editorial-grid.png';
---
<article class={`dish-card dish-card--${dish.image}`} data-dish data-moment={dish.moment}>
  <button class="dish-card__button" type="button" data-open-dish={dish.slug} aria-haspopup="dialog">
    <span class="dish-card__image-wrap"><img src={photo} alt="" width="1200" height="800" loading={index > 2 ? 'lazy' : 'eager'} /></span>
    <span class="dish-card__topline"><span>{String(index + 1).padStart(2, '0')} · {dish.moment}</span><strong>{dish.price} €</strong></span>
    <span class="dish-card__name">{dish.name}</span>
    <span class="dish-card__summary">{dish.summary}</span>
    <span class="dish-card__more">Ver composición <span aria-hidden="true">↗</span></span>
  </button>
</article>
