---
import { menus } from '../data/menus';
import BarMenu from '../components/BarMenu.astro';
import MediterraneanMenu from '../components/MediterraneanMenu.astro';
import ProductMenu from '../components/ProductMenu.astro';
import TastingMenu from '../components/TastingMenu.astro';
import CantonMenu from '../components/CantonMenu.astro';
import '../styles/global.css';

const menuViews = [BarMenu, MediterraneanMenu, ProductMenu, TastingMenu, CantonMenu];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2ea" />
    <meta name="description" content="Cinco cartas online pensadas para la forma de servir de cada restaurante." />
    <title>Cartas con identidad · Carta Abierta</title>
  </head>
  <body data-theme="bar">
    <main class="showcase">
      <nav class="menu-switcher" id="cartas" aria-label="Elegir carta de ejemplo">
        <div class="switcher-brand"><span>c.</span><strong>Carta Abierta</strong></div>
        <div class="tabs" role="tablist" aria-label="Cartas de ejemplo">
          {menus.map((menu, index) => <button class="tab-button" id={`tab-${menu.id}`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${menu.id}`} tabindex={index === 0 ? 0 : -1} data-menu-tab={menu.id}>
            <span>{menu.tabLabel}</span>
          </button>)}
        </div>
      </nav>

      <div class="menu-panels">
        {menus.map((menu, index) => {
          const View = menuViews[index];
          return <section class="menu-panel" id={`panel-${menu.id}`} role="tabpanel" aria-labelledby={`tab-${menu.id}`} tabindex="0" data-menu-panel={menu.id} data-theme={menu.id} hidden={index !== 0}>
            <View menu={menu} />
          </section>;
        })}
      </div>
    </main>

    <dialog class="photo-dialog" id="photo-dialog" aria-labelledby="photo-dialog-title">
      <div class="photo-dialog__top"><h2 id="photo-dialog-title"></h2><button class="photo-dialog__close" type="button" data-photo-close aria-label="Cerrar foto">×</button></div>
      <img class="photo-dialog__image" src="" alt="" draggable="false" />
      <div class="photo-dialog__actions"><button class="photo-dialog__3d" type="button" data-3d-button>Ver en 3D</button><span>Vista ampliada</span></div>
      <p class="photo-dialog__notice" data-3d-notice hidden>Estamos preparando la vista 3D para verla con la cámara sobre la mesa.</p>
    </dialog>

    <dialog class="ar-dialog" id="ar-dialog" aria-labelledby="ar-dialog-title">
      <div class="ar-dialog__top"><div><small>Prueba de realidad aumentada</small><h2 id="ar-dialog-title">Patatas bravas en tu mesa</h2></div><button type="button" class="ar-dialog__close" data-ar-close aria-label="Cerrar vista 3D">×</button></div>
      <model-viewer id="bravas-model" src="/models/patatas-bravas.glb" poster="/images/menus/bar/patatas-bravas.webp" alt="Modelo 3D de prueba de unas patatas bravas en un plato de 24 centímetros" ar ar-modes="webxr scene-viewer quick-look" ar-scale="fixed" ar-placement="floor" camera-controls touch-action="pan-y" shadow-intensity="1" exposure="1.1" camera-orbit="0deg 65deg 0.55m" field-of-view="30deg" loading="eager"></model-viewer>
      <div class="ar-dialog__details"><p>Plato de prueba · 24 cm de diámetro · Patatas, salsa brava, alioli y perejil.</p><button type="button" data-ar-launch disabled>Preparando plato 3D…</button><span data-ar-message>Apunta la cámara a una superficie plana y mueve el móvil lentamente.</span></div>
    </dialog>

    <script>
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-menu-tab]'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-panel]'));

      function activateMenu(id: string, moveFocus = false) {
        const selectedTab = tabs.find((tab) => tab.dataset.menuTab === id);
        const selectedPanel = panels.find((panel) => panel.dataset.menuPanel === id);
        if (!selectedTab || !selectedPanel) return;
        for (const tab of tabs) {
          const selected = tab === selectedTab;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        }
        for (const panel of panels) panel.hidden = panel !== selectedPanel;
        document.body.dataset.theme = id;
        if (moveFocus) selectedTab.focus();
        else if (window.scrollY > 120) document.getElementById('cartas')?.scrollIntoView({ block: 'start' });
      }

      for (const tab of tabs) {
        tab.addEventListener('click', () => activateMenu(tab.dataset.menuTab ?? ''));
        tab.addEventListener('keydown', (event) => {
          const index = tabs.indexOf(tab);
          const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length
            : event.key === 'ArrowLeft' ? (index - 1 + tabs.length) % tabs.length
            : event.key === 'Home' ? 0
            : event.key === 'End' ? tabs.length - 1
            : -1;
          if (next >= 0) { event.preventDefault(); activateMenu(tabs[next].dataset.menuTab ?? '', true); }
        });
      }

      const photoDialog = document.querySelector<HTMLDialogElement>('#photo-dialog');
      const photoImage = photoDialog?.querySelector<HTMLImageElement>('.photo-dialog__image');
      const photoTitle = photoDialog?.querySelector<HTMLElement>('#photo-dialog-title');
      const photoNotice = photoDialog?.querySelector<HTMLElement>('[data-3d-notice]');
      const arDialog = document.querySelector<HTMLDialogElement>('#ar-dialog');
      const modelViewer = document.querySelector<HTMLElement & { canActivateAR?: boolean; activateAR?: () => Promise<void> }>('#bravas-model');
      const arMessage = arDialog?.querySelector<HTMLElement>('[data-ar-message]');
      const arLaunch = arDialog?.querySelector<HTMLButtonElement>('[data-ar-launch]');
      let modelReady: Promise<unknown> | null = null;
      modelViewer?.addEventListener('load', () => {
        if (arLaunch) { arLaunch.disabled = false; arLaunch.textContent = 'Colocar sobre mi mesa'; }
      });
      modelViewer?.addEventListener('ar-status', (event: Event) => {
        if ((event as CustomEvent<{ status: string }>).detail?.status === 'failed' && arMessage) {
          arMessage.textContent = 'La cámara no ha podido encontrar una superficie. Muévela lentamente y vuelve a intentarlo.';
        }
      });
      let lastPhotoButton: HTMLButtonElement | null = null;
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-photo-open]')) {
        button.addEventListener('click', () => {
          if (!photoDialog || !photoImage || !photoTitle || !photoNotice) return;
          lastPhotoButton = button;
          photoImage.src = button.dataset.photoSrc ?? '';
          photoImage.alt = button.dataset.photoName ?? '';
          photoTitle.textContent = button.dataset.photoName ?? '';
          photoNotice.hidden = true;
          photoDialog.dataset.modelAvailable = button.dataset.photoName === 'Patatas bravas' ? 'true' : 'false';
          const modelButton = photoDialog.querySelector<HTMLButtonElement>('[data-3d-button]');
          if (modelButton) modelButton.textContent = photoDialog.dataset.modelAvailable === 'true' ? 'Ver en 3D' : '3D próximamente';
          if (photoDialog.dataset.modelAvailable === 'true') modelReady ??= import('@google/model-viewer');
          photoDialog.showModal();
        });
      }
      photoDialog?.querySelector('[data-photo-close]')?.addEventListener('click', () => photoDialog.close());
      photoDialog?.querySelector('[data-3d-button]')?.addEventListener('click', () => {
        if (photoDialog?.dataset.modelAvailable !== 'true') {
          if (photoNotice) photoNotice.hidden = false;
          return;
        }
        photoDialog.close();
        arDialog?.showModal();
        if (modelViewer?.canActivateAR && modelViewer.activateAR) {
          modelViewer.activateAR().catch(() => {
            if (arMessage) arMessage.textContent = 'La cámara no se ha podido abrir. Puedes girar el plato en 3D aquí.';
          });
        }
      });
      photoDialog?.addEventListener('click', (event) => { if (event.target === photoDialog) photoDialog.close(); });
      photoDialog?.addEventListener('close', () => { lastPhotoButton?.focus(); });
      arDialog?.querySelector('[data-ar-close]')?.addEventListener('click', () => arDialog.close());
      arLaunch?.addEventListener('click', () => {
        if (modelViewer?.canActivateAR && modelViewer.activateAR) modelViewer.activateAR().catch(() => {
          if (arMessage) arMessage.textContent = 'La cámara no se ha podido abrir en este dispositivo.';
        });
        else if (arMessage) arMessage.textContent = 'Este navegador no permite abrir la cámara para AR. Puedes girar el plato en 3D aquí.';
      });
      arDialog?.addEventListener('click', (event) => { if (event.target === arDialog) arDialog.close(); });
      arDialog?.addEventListener('close', () => { lastPhotoButton?.focus(); });
    </script>
  </body>
</html>
